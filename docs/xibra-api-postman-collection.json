{
  "info": {
    "name": "Xibra API - Postman Collection",
    "_postman_id": "xibra-api-collection-v1",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Collection for testing all Xibra API endpoints (Laravel + Sanctum + PostgreSQL)"
  },
  "variables": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string",
      "description": "Base URL Xibra API development server"
    },
    {
      "key": "auth_token",
      "value": "",
      "type": "string",
      "description": "Bearer token from login (auto-filled after login request)"
    },
    {
      "key": "user_id",
      "value": "",
      "type": "string",
      "description": "User ID from login response"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "LOGIN - Get Bearer Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identity\": \"rizkyxibrahim\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "description": "Login with username/email/phone + password. Response will contain Bearer token.\n\nUse this token for all subsequent requests in Authorization tab \u2192 Bearer Token."
          },
          "response": [
            {
              "name": "Login Success",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"status\": \"success\",\n  \"code\": \"AUTH_LOGIN_SUCCESS\",\n  \"message\": \"Login successful.\",\n  \"data\": {\n    \"user\": {\n      \"id\": 1,\n      \"name\": \"Rizky Ibrahim\",\n      \"username\": \"rizkyxibrahim\",\n      \"email\": \"rizky@example.com\",\n      \"phone\": \"08123456789\"\n    },\n    \"token\": \"1|abc123...\",\n    \"token_type\": \"Bearer\"\n  }\n}"
            }
          ],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response has token\", function () {",
                  "  var json = pm.response.json();",
                  "  pm.expect(json.data.token).to.not.be.empty;",
                  "});",
                  "pm.test(\"Save token to collection variable\", function () {",
                  "  var json = pm.response.json();",
                  "  pm.collectionVariables.set(\"auth_token\", json.data.token);",
                  "  pm.collectionVariables.set(\"user_id\", json.data.user.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "FORGOT PASSWORD - Send Reset Link",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"rizky@example.com\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/forgot-password",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "forgot-password"
              ]
            },
            "description": "Send password reset link to registered email. No authentication required."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response has success message\", function () {",
                  "  var json = pm.response.json();",
                  "  pm.expect(json.code).to.eql(\"PASSWORD_RESET_LINK_SENT\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "RESET PASSWORD - Change Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"rizky@example.com\",\n  \"token\": \"<token_from_email>\",\n  \"password\": \"newpassword123\",\n  \"password_confirmation\": \"newpassword123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/reset-password",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "reset-password"
              ]
            },
            "description": "Reset password using token received via email. Token expires after 60 minutes."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Password reset successful\", function () {",
                  "  var json = pm.response.json();",
                  "  pm.expect(json.code).to.eql(\"PASSWORD_RESET_SUCCESS\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
