{
  "info": {
    "name": "Xibra API - Postman Collection",
    "_postman_id": "xibra-api-collection-v1",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Collection untuk testing semua endpoint Xibra API (Laravel + Sanctum + PostgreSQL)"
  },
  "variables": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string",
      "description": "Base URL Xibra API development server"
    },
    {
      "key": "auth_token",
      "value": "",
      "type": "string",
      "description": "Bearer token dari login (diisi otomatis setelah request login)"
    },
    {
      "key": "user_id",
      "value": "",
      "type": "string",
      "description": "ID user dari response login"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "LOGIN - Dapatkan Bearer Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identity\": \"rizkyxibrahim\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "login"]
            },
            "description": "Login dengan username/email/phone + password. Respons akan berisi Bearer token.\n\nGunakan token ini untuk semua request berikutnya di tab Authorization → Bearer Token."
          },
          "response": [
            {
              "name": "Login Success",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"status\": \"success\",\n  \"code\": \"AUTH_LOGIN_SUCCESS\",\n  \"message\": \"Login berhasil\",\n  \"data\": {\n    \"user\": {\n      \"id\": 1,\n      \"name\": \"Rizky Ibrahim\",\n      \"username\": \"rizkyxibrahim\",\n      \"email\": \"rizky@example.com\",\n      \"phone\": \"08123456789\"\n    },\n    \"token\": \"1|abc123...\",\n    \"token_type\": \"Bearer\"\n  }\n}"
            }
          ],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response has token\", function () {",
                  "  var json = pm.response.json();",
                  "  pm.expect(json.data.token).to.not.be.empty;",
                  "});",
                  "pm.test(\"Save token to collection variable\", function () {",
                  "  var json = pm.response.json();",
                  "  pm.collectionVariables.set(\"auth_token\", json.data.token);",
                  "  pm.collectionVariables.set(\"user_id\", json.data.user.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "ME - Cek Profil Login",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/me",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "me"]
            },
            "description": "Mengambil profil pengguna yang sedang login. Memerlukan Bearer token."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response has user data\", function () {",
                  "  var json = pm.response.json();",
                  "  pm.expect(json.data).to.not.be.empty;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "LOGOUT - Revoke Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/logout",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "logout"]
            },
            "description": "Logout dan revoke token aktif."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
